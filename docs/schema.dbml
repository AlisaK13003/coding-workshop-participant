// Project Tracker database, for https://dbdiagram.io (paste into the editor).
// Source of truth: backend/db/schema.sql. Relationships are drawn on the id columns;
// rules the database also enforces (same-project checks, manager roles, one-per-day…)
// are in the notes.

Project project_tracker {
  database_type: 'PostgreSQL'
}

Table users {
  id integer [pk, increment]
  display_id text [note: 'Generated: USR-0001 from id']
  first_name text [not null]
  last_name text [not null]
  username text [not null, note: 'Generated by trigger set_username when omitted; unique ignoring case']
  password_hash text [not null, note: 'bcrypt']
  email text [not null, note: 'Unique ignoring case']
  job_title text [not null]
  role text [not null, note: 'admin | manager | employee']
  manager_id integer [note: 'Employees only (required); must be a manager']
  manager_role text [not null, default: 'manager', note: 'Helper for the "must be a manager" foreign key']
  annual_salary numeric(10,2) [note: 'Employees only (required)']
  archived_at timestamptz [note: 'Empty = active']

  indexes {
    (id, role) [unique]
    `lower(username)` [unique, name: 'username_unique']
    `lower(email)` [unique, name: 'email_unique']
  }
  Note: 'Checks: employees have a manager and a salary; admins and managers have neither.'
}

Table projects {
  id integer [pk, increment]
  name text [not null, note: 'Unique ignoring case']
  manager_id integer [note: 'Must be a manager; empty after unarchiving until reassigned']
  manager_role text [not null, default: 'manager']
  start_date date [not null]
  end_date date [not null, note: 'Predicted end; on or after start_date']
  budget numeric(12,2) [not null, note: '>= 0']
  status text [not null, default: 'in_progress', note: 'in_progress | completed | abandoned']
  archived_at timestamptz [note: 'Only completed or abandoned projects can be archived']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(name)` [unique, name: 'project_name_unique']
  }
}

Table milestones {
  id integer [pk, increment]
  project_id integer [not null]
  name text [not null]
  start_date date [not null, note: 'Within the project dates']
  end_date date [not null]
  completed_at timestamptz [note: 'Empty = not completed; never cleared once set']

  indexes {
    (id, project_id) [unique]
  }
  Note: 'Status is derived: completed / awaiting_review / blocked / available.'
}

Table milestone_dependencies {
  milestone_id integer [not null]
  prerequisite_id integer [not null]
  project_id integer [not null, note: 'Both milestones must be in this project']

  indexes {
    (milestone_id, prerequisite_id) [pk]
  }
  Note: 'milestone_id can only start once prerequisite_id is completed. No self-links; no cycles (checked in the backend).'
}

Table project_members {
  id integer [pk, increment]
  project_id integer [not null]
  employee_id integer [not null]
  added_at timestamptz [not null, default: `now()`]
  removed_at timestamptz [note: 'Empty = current member']
  milestone_id integer [note: 'Current milestone in this project (one per project)']

  indexes {
    (project_id, employee_id) [unique, name: 'one_active_membership', note: 'WHERE removed_at IS NULL']
  }
}

Table milestone_reviews {
  id integer [pk, increment]
  milestone_id integer [not null]
  requested_by integer [not null]
  requested_at timestamptz [not null, default: `now()`]
  decision text [note: 'accepted | kept_open; empty = waiting']
  decided_by integer
  decided_at timestamptz
  feedback text

  indexes {
    milestone_id [unique, name: 'one_open_review', note: 'WHERE decision IS NULL']
  }
}

Table work_logs {
  id integer [pk, increment]
  employee_id integer [not null]
  project_id integer [not null]
  milestone_id integer [not null, note: 'Must belong to project_id']
  work_date date [not null, note: 'Weekdays only']
  hours numeric(4,2) [not null, default: 8, note: 'Always 8']
  hourly_rate numeric(10,2) [not null, note: 'annual_salary / 2080, saved when logged']
  entered_by integer [not null, note: 'The employee, or an admin for past entries']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, work_date) [unique, name: 'one_log_per_day']
  }
}

Table activity_log {
  id integer [pk, increment]
  actor_id integer [not null]
  actor_role text [not null, note: 'Role at the time of the action']
  action text [not null, note: 'e.g. project.update']
  entity_type text [not null]
  entity_id integer [not null]
  project_id integer
  summary text [not null]
  changes jsonb [note: '{field: {from, to}}']
  created_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id integer [pk, increment]
  recipient_id integer [not null]
  title text [not null]
  detail text
  project_id integer
  milestone_id integer [note: 'Must belong to project_id']
  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz [note: 'Empty = unread']
}

// Relationships
Ref: users.manager_id > users.id
Ref: projects.manager_id > users.id
Ref: milestones.project_id > projects.id
Ref: milestone_dependencies.milestone_id > milestones.id
Ref: milestone_dependencies.prerequisite_id > milestones.id
Ref: milestone_dependencies.project_id > projects.id
Ref: project_members.project_id > projects.id
Ref: project_members.employee_id > users.id
Ref: project_members.milestone_id > milestones.id
Ref: milestone_reviews.milestone_id > milestones.id
Ref: milestone_reviews.requested_by > users.id
Ref: milestone_reviews.decided_by > users.id
Ref: work_logs.employee_id > users.id
Ref: work_logs.project_id > projects.id
Ref: work_logs.milestone_id > milestones.id
Ref: work_logs.entered_by > users.id
Ref: activity_log.actor_id > users.id
Ref: activity_log.project_id > projects.id
Ref: notifications.recipient_id > users.id
Ref: notifications.project_id > projects.id
Ref: notifications.milestone_id > milestones.id

Table app_settings {
  name text [pk, note: "e.g. 'jwt_secret'"]
  value text [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Values the backend generates for itself. On AWS it holds the JWT signing key, created on first use; never exposed through the API.'
}
